      "id": "file:components/background_hang_monitor/background_hang_monitor.rs",
      "type": "file",
      "name": "background_hang_monitor.rs",
      "filePath": "components/background_hang_monitor/background_hang_monitor.rs",
      "summary": "Core implementation of the background hang monitoring system, managing component registration, periodic hang detection checkpoints, and sampled profiling of native thread stacks.",
      "tags": ["hang-monitoring", "thread-sampler", "profiler", "component-registry"],
      "complexity": "complex",
      "languageNotes": "Uses crossbeam channels for IPC between the monitoring worker and monitored components, and trait objects (Box<dyn Sampler>) for platform-specific thread sampling."
    },
    {
      "id": "file:components/background_hang_monitor/lib.rs",
      "type": "file",
      "name": "lib.rs",
      "filePath": "components/background_hang_monitor/lib.rs",
      "summary": "Crate root that conditionally compiles platform-specific sampler modules (Linux, macOS, Windows) and re-exports the background hang monitor public API.",
      "tags": ["module-root", "conditional-compilation", "re-exports", "crate-entry"],
      "complexity": "simple",
      "languageNotes": "Conditional compilation via cfg attributes selects the SamplerImpl alias based on target OS and architecture, with a fallback DummySampler for unsupported platforms."
    },
    {
      "id": "file:components/background_hang_monitor/sampler.rs",
      "type": "file",
      "name": "sampler.rs",
      "filePath": "components/background_hang_monitor/sampler.rs",
      "summary": "Defines the Sampler trait for platform-specific thread suspension and sampling, and the NativeStack data structure for collecting native thread stack traces with symbol resolution and demangling.",
      "tags": ["trait-definition", "stack-trace", "symbol-resolution", "native-stack"],
      "complexity": "moderate"
    },
    {
      "id": "file:components/background_hang_monitor/sampler_linux.rs",
