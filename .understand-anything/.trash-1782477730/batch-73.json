      "name": "sampler_linux.rs",
      "filePath": "components/background_hang_monitor/sampler_linux.rs",
      "summary": "Linux implementation of the Sampler trait using POSIX semaphores for inter-thread synchronization and SIGPROF signal handlers for suspending and sampling target threads.",
      "tags": ["platform-specific", "linux", "signal-handler", "posix-semaphore"],
      "complexity": "complex",
      "languageNotes": "Uses unsafe shared state via a static UncheckedSyncUnsafeCell with semaphore-based synchronization between the sampling thread and signal handler."
    },
