    },
    {
      "id": "file:components/script_bindings/third_party/ply/example/BASIC/basinterp.py",
      "type": "file",
      "name": "basinterp.py",
      "filePath": "components/script_bindings/third_party/ply/example/BASIC/basinterp.py",
      "summary": "Full BASIC interpreter runtime implementing statement execution for Dartmouth BASIC programs. The BasicInterpreter class handles variable assignment, arithmetic expressions, control flow (FOR/NEXT, IF/GOTO), subroutines (GOSUB/RETURN), array operations (DIM), and built-in math functions.",
      "tags": ["interpreter", "runtime", "basic-language", "expression-evaluation"],
      "complexity": "complex",
      "languageNotes": "Implements recursive expression evaluation via self.eval() dispatching on parse tree nodes, mirroring the grammar production rules."
    },
    {
      "id": "file:components/script_bindings/third_party/ply/example/BASIC/basparse.py",
      "type": "file",
      "name": "basparse.py",
      "filePath": "components/script_bindings/third_party/ply/example/BASIC/basparse.py",
      "summary": "PLY parser grammar specification for Dartmouth BASIC. Defines production rules for all BASIC statements (LET, PRINT, IF, FOR, GOTO, GOSUB, DIM, READ, DATA, REM, DEF, END, STOP), expressions with binary/unary operators, and variable references with array subscript support.",
      "tags": ["parser", "grammar", "basic-language", "yacc"],
      "complexity": "complex",
      "languageNotes": "Uses PLY yacc conventions where p_NAME functions define grammar production rules with documentation strings specifying the grammar."
    },
    {
      "id": "file:components/script_bindings/third_party/ply/example/GardenSnake/GardenSnake.py",
      "type": "file",
      "name": "GardenSnake.py",
      "filePath": "components/script_bindings/third_party/ply/example/GardenSnake/GardenSnake.py",
      "summary": "Complete Python parser and compiler for a simplified Python-like language built with PLY. Includes an indentation-aware lexer (IndentLexer), full parser grammar for function definitions, if statements, expressions, and AST construction with compilation to Python bytecode.",
      "tags": ["parser", "compiler", "grammar", "ast", "indentation"],
      "complexity": "complex",
      "languageNotes": "Implements indentation-sensitive lexing via INDENT/DEDENT token generation, similar to Python's own tokenizer, and compiles the AST to Python code objects using the compiler module."
    },
    {
