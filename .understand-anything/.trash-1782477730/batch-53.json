      "name": "basiclex.py",
      "filePath": "components/script_bindings/third_party/ply/example/BASIC/basiclex.py",
      "summary": "PLY lexer specification for Dartmouth BASIC. Defines token rules for identifiers, REM statements, NEWLINEs, and error handling using PLY naming conventions for the BASIC example interpreter.",
      "tags": ["lexer", "tokenizer", "basic-language"],
      "complexity": "simple",
      "languageNotes": "Uses PLY's naming convention where t_NAME functions define token rules and t_error handles illegal characters."
