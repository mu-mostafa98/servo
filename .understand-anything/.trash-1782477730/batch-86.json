      "complexity": "moderate"
    },
    {
      "id": "file:components/shared/fonts/font_template.rs",
      "type": "file",
      "name": "font_template.rs",
      "filePath": "components/shared/fonts/font_template.rs",
      "summary": "Implements FontTemplate and FontTemplateDescriptor types for the CSS font matching algorithm. Provides match_distance implementations for font-stretch, font-weight, and font-style according to the CSS Fonts specification, and computes variable font variation settings based on CSS descriptors.",
      "tags": ["font", "template", "matching", "css-font", "font-matching-algorithm"],
      "complexity": "complex",
      "languageNotes": "Implements the CSS font matching algorithm ported from Gecko, with weighted distance scoring for stretch, style, and weight axes."
    },
