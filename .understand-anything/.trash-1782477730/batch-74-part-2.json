      "name": "network_handler.rs",
      "filePath": "components/devtools/network_handler.rs",
      "summary": "Handles network event dispatching for the DevTools protocol, processing request, response, and security info updates by emitting resource-available notifications through the WatcherActor.",
      "tags": ["network-events", "devtools-protocol", "event-handler", "http"],
      "complexity": "moderate"
    },
    {
      "id": "class:components/devtools/network_handler.rs:Cause",
      "type": "class",
      "name": "Cause",
      "filePath": "components/devtools/network_handler.rs",
      "lineRange": [19, 23],
      "summary": "Represents the cause of a network request, with a type field and optional loading document URI, serialized in camelCase for the DevTools protocol.",
      "tags": ["network", "cause", "data-model"],
      "complexity": "simple"
    },
    {
      "id": "function:components/devtools/network_handler.rs:handle_network_event",
      "type": "function",
      "name": "handle_network_event",
      "filePath": "components/devtools/network_handler.rs",
      "lineRange": [25, 100],
      "summary": "Dispatches network event updates to connected clients by looking up the NetworkEventActor, encoding event state, and pushing resource-available/updated notifications through the WatcherActor for each event phase (request, response, security info).",
      "tags": ["network", "event-handler", "dispatch"],
      "complexity": "moderate"
    },
    {
      "id": "file:components/devtools/protocol.rs",
      "type": "file",
      "name": "protocol.rs",
      "filePath": "components/devtools/protocol.rs",
      "summary": "Implements the DevTools remote protocol transport layer including JSON packet reading and writing over TCP streams, the DevtoolsConnection wrapper with length-prefixed packets, and ClientRequest for actor command handling with reply validation.",
      "tags": ["protocol", "tcp-transport", "json-serialization", "devtools"],
      "complexity": "moderate",
      "languageNotes": "Uses a custom length-prefixed JSON framing format (length:data) similar to the Firefox DevTools wire protocol."
    },
